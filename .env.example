# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every value here is a placeholder. The stack refuses to start if the required ones are missing,
# which is deliberate: a default password that "works out of the box" is a default password that
# reaches production.

# --- SQL Server -------------------------------------------------------------
# At least 8 characters with upper case, lower case, digits and symbols, or SQL Server rejects it.
MSSQL_SA_PASSWORD=CHANGE_ME_strong_password_here
MSSQL_DATABASE=MyMES

# --- API ---------------------------------------------------------------------
# Signing key for the bearer tokens, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_at_least_32_characters_of_random_data
JWT_ISSUER=MyMES
JWT_AUDIENCE=MyMES

# --- First administrator ------------------------------------------------------
# Created once, only when no administrator exists yet. Leave blank to create none and set the
# first account up another way. Change the password after the first sign-in.
MYMES_ADMIN_USERNAME=
MYMES_ADMIN_EMAIL=
MYMES_ADMIN_PASSWORD=

# --- MachineService -------------------------------------------------------------
# A normal MES account with the Maintenance role. Without it the worker polls and logs but
# reports nothing to the MES.
MACHINE_SERVICE_USERNAME=
MACHINE_SERVICE_PASSWORD=
MACHINE_POLL_SECONDS=10

# --- Hosting ----------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5100
WEB_PORT=5200
SWAGGER_ENABLED=true
