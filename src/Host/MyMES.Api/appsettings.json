{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MyMes": ""
  },
  "Database": {
    "AutoMigrate": false,
    "MaxRetryCount": 5,
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "MyMES",
    "Audience": "MyMES",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "Identity": {
    "Bootstrap": {
      "AdministratorUserName": "",
      "AdministratorEmail": "",
      "AdministratorPassword": ""
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "Origins": []
  },
  "Extensions": {
    "ProductLogger": { "Enabled": true }
  }
}
