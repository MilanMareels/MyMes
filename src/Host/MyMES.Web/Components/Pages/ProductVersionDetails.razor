@page "/products-version-details/{versionId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@inject MyMesApiClient Api

@if (_productVersion != null)
{
    <PageTitle>Product Version - @_productVersion.VersionNumber</PageTitle>

    <div class="page-head">
        <div>
            <h1>BOM for Product Version - @_productVersion.VersionNumber</h1>
            <p class="muted">The BOM for the product.</p>
            <span class="badge ok">Active from: @_productVersion.EffectiveFrom to @_productVersion.EffectiveTo</span>
            <StatusBadge Version="_productVersion.Status" />
        </div>
    </div>

    <table class="data">
        <thead>
            <tr>
                <th>Product Code</th>
                <th>Product Name</th>
                <th>Product Unit Of Measure</th>
                <th>Quantity</th>
                <th>Sequence</th>
                <th>Step name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bom in _productVersion.BomItems)
            {
                <tr>
                    <td class="muted small">@bom.ComponentProduct!.ProductCode</td>
                    <td class="muted small">@bom.ComponentProduct.Name</td>
                    <td class="muted small">@bom.ComponentProduct.UnitOfMeasure</td>
                    <td class="muted small">@bom.Quantity</td>
                    <td class="muted small">@_productVersion.RoutingSteps.FirstOrDefault(x => x.Id ==
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    bom.RoutingStepId)!.Sequence</td>
                        <td class="muted small">@_productVersion.RoutingSteps.FirstOrDefault(x => x.Id ==
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bom.RoutingStepId)!.Name</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

@code {
    [Parameter]
    public Guid versionId { get; set; }
    public ProductVersionDto _productVersion { get; set; } = null;
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _productVersion = await Api.GetProductVersionDetails(versionId);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}